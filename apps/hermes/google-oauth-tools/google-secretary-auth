#!/usr/bin/env python3
"""Tokenless client for the loopback Google OAuth/read broker."""

from __future__ import annotations

import argparse
import json
import re
import sys
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlencode
from urllib.request import Request, urlopen

BASE_URL = "http://127.0.0.1:8792"
MAX_LIMIT = 20
MESSAGE_ID_RE = re.compile(r"^[A-Za-z0-9_-]+$")
CALENDAR_ID_RE = re.compile(r"^[^/?#]+$")


def bounded_limit(value: str) -> int:
    try:
        result = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("limit must be an integer between 1 and 20") from error
    if not 1 <= result <= MAX_LIMIT:
        raise argparse.ArgumentTypeError("limit must be an integer between 1 and 20")
    return result


def message_id(value: str) -> str:
    if not MESSAGE_ID_RE.fullmatch(value):
        raise argparse.ArgumentTypeError("message_id is invalid")
    return value


def calendar_id(value: str) -> str:
    if not value or not CALENDAR_ID_RE.fullmatch(value):
        raise argparse.ArgumentTypeError("calendar_id is invalid")
    return value


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status")
    commands.add_parser("start")
    exchange = commands.add_parser("exchange")
    exchange.set_defaults(read_callback=True)

    commands.add_parser("calendar-list")
    events = commands.add_parser("calendar-events")
    events.add_argument("--calendar-id", type=calendar_id, default="primary")
    events.add_argument("--start")
    events.add_argument("--end")
    events.add_argument("--limit", type=bounded_limit, default=MAX_LIMIT)

    messages = commands.add_parser("gmail-list")
    messages.add_argument("--query", default="")
    messages.add_argument("--limit", type=bounded_limit, default=MAX_LIMIT)

    get_message = commands.add_parser("gmail-get")
    get_message.add_argument("message_id", type=message_id)
    return parser


def path_for(args: argparse.Namespace) -> str:
    if args.command == "calendar-list":
        return "/calendar/list"
    if args.command == "calendar-events":
        query: dict[str, str] = {"calendar_id": args.calendar_id}
        if args.start is not None:
            query["start"] = args.start
        if args.end is not None:
            query["end"] = args.end
        query["limit"] = str(args.limit)
        return f"/calendar/events?{urlencode(query)}"
    if args.command == "gmail-list":
        query = {"query": args.query, "limit": str(args.limit)}
        return f"/gmail/messages?{urlencode(query)}"
    if args.command == "gmail-get":
        return f"/gmail/messages/{quote(args.message_id, safe='-_')}"
    raise ValueError("command has no read route")


def request(method: str, path: str, payload: dict | None = None) -> None:
    allowed = {
        ("GET", "/oauth/status"),
        ("POST", "/oauth/start"),
        ("POST", "/oauth/exchange"),
    }
    is_read_route = method == "GET" and (
        path == "/calendar/list"
        or path.startswith("/calendar/events?")
        or path.startswith("/gmail/messages?")
        or re.fullmatch(r"/gmail/messages/[A-Za-z0-9_-]+", path)
    )
    if (method, path) not in allowed and not is_read_route:
        raise ValueError("unsupported broker operation")
    body = None if payload is None else json.dumps(payload, separators=(",", ":")).encode("utf-8")
    headers = {"Accept": "application/json"}
    if body is not None:
        headers["Content-Type"] = "application/json"
    try:
        with urlopen(Request(f"{BASE_URL}{path}", data=body, headers=headers, method=method), timeout=20) as response:
            print(json.dumps(json.loads(response.read().decode("utf-8")), ensure_ascii=False, indent=2))
    except HTTPError as error:
        try:
            message = json.loads(error.read().decode("utf-8")).get("error", "Google broker request failed")
        except (json.JSONDecodeError, UnicodeDecodeError):
            message = "Google broker request failed"
        print(f"ERROR: {message}", file=sys.stderr)
        raise SystemExit(1)
    except URLError:
        print("ERROR: Google OAuth broker is unavailable", file=sys.stderr)
        raise SystemExit(1)


def main() -> None:
    args = build_parser().parse_args()
    if args.command == "status":
        request("GET", "/oauth/status")
    elif args.command == "start":
        request("POST", "/oauth/start", {})
    elif args.command == "exchange":
        callback_url = sys.stdin.read().strip()
        if not callback_url:
            raise SystemExit("ERROR: provide the complete localhost callback URL on standard input")
        request("POST", "/oauth/exchange", {"callback_url": callback_url})
    else:
        request("GET", path_for(args))


if __name__ == "__main__":
    main()
