#!/usr/bin/env python3
"""Client for the loopback-only Google OAuth broker."""

from __future__ import annotations

import argparse
import json
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

BASE_URL = "http://127.0.0.1:8792"


def request(method: str, path: str, payload: dict | None = None) -> None:
    body = None if payload is None else json.dumps(payload).encode("utf-8")
    headers = {"Accept": "application/json"}
    if body is not None:
        headers["Content-Type"] = "application/json"
    try:
        with urlopen(Request(f"{BASE_URL}{path}", data=body, headers=headers, method=method), timeout=20) as response:
            print(json.dumps(json.loads(response.read().decode("utf-8")), ensure_ascii=False, indent=2))
    except HTTPError as error:
        try:
            message = json.loads(error.read().decode("utf-8")).get("error", "Google OAuth broker request failed")
        except (json.JSONDecodeError, UnicodeDecodeError):
            message = "Google OAuth broker request failed"
        print(f"ERROR: {message}", file=sys.stderr)
        raise SystemExit(1)
    except URLError:
        print("ERROR: Google OAuth broker is unavailable", file=sys.stderr)
        raise SystemExit(1)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status")
    commands.add_parser("start")
    commands.add_parser("exchange")
    args = parser.parse_args()
    if args.command == "status":
        request("GET", "/oauth/status")
    elif args.command == "start":
        request("POST", "/oauth/start", {})
    else:
        callback_url = sys.stdin.read().strip()
        if not callback_url:
            raise SystemExit("ERROR: provide the complete localhost callback URL on standard input")
        request("POST", "/oauth/exchange", {"callback_url": callback_url})


if __name__ == "__main__":
    main()
