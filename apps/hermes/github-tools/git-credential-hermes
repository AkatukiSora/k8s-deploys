#!/bin/sh
set -eu

operation="${1:-}"
[ "$operation" = "get" ] || exit 0

host=""
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  case "$key" in
    host) host="$value" ;;
  esac
done

[ "$host" = "github.com" ] || exit 0

token_file="${HERMES_GITHUB_TOKEN_FILE:-/var/run/github-token/token}"
if [ ! -r "$token_file" ] || [ ! -f "$token_file" ]; then
  echo "git-credential-hermes: GitHub installation token is not ready" >&2
  exit 1
fi

printf 'username=x-access-token\n'
printf 'password=%s\n\n' "$(cat "$token_file")"
