apiVersion: v1
kind: Config
clusters:
  - cluster:
      certificate-authority: /var/run/hermes-kubernetes/ca.crt
      server: https://c.k8s.internal:6443
    name: k8s-soralab
contexts:
  - context:
      cluster: k8s-soralab
      namespace: hermes
      user: hermes
    name: hermes
current-context: hermes
users:
  - name: hermes
    user:
      tokenFile: /var/run/hermes-kubernetes/token
