{
  "$schema": "https://opencode.ai/config.json",

  // Build and Plan remain OpenCode's built-in primary agents. Their model is
  // intentionally left to the user's selected primary model.
  "subagent_depth": 1,
  "share": "manual",

  // Permit normal agent work without confirmation.  Keep operations that can
  // alter history, the live cluster, or files outside this worktree blocked.
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "kubectl apply *": "deny",
      "kubectl delete *": "deny",
      "kubectl patch *": "deny",
      "kubectl edit *": "deny",
      "helm install *": "deny",
      "helm upgrade *": "deny",
      "helm uninstall *": "deny",
    },
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow"
  },

  "agent": {
    "build": {
      "prompt": "{file:./.opencode/prompts/build.md}",
      "permission": { "task": { "*": "deny", "explore": "allow", "general": "allow", "luna-implement": "allow", "luna-verify": "allow" } }
    },
    "plan": {
      "prompt": "{file:./.opencode/prompts/plan.md}",
      "permission": { "task": { "*": "deny", "explore": "allow", "general": "allow" } }
    },
    "explore": {
      "description": "High-volume read-only repository investigation with compact evidence output",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./.opencode/prompts/luna-explore.md}",
      "temperature": 0.1,
      "steps": 35,
      "permission": {
        "read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "lsp": "allow", "edit": "deny", "external_directory": "deny", "question": "deny", "todowrite": "deny", "webfetch": "allow", "websearch": "allow",
        "bash": { "*": "allow", "rm *": "deny", "git commit *": "deny", "git push *": "deny", "git reset *": "deny", "git switch *": "deny", "git checkout *": "deny", "git clean *": "deny", "kubectl apply *": "deny", "kubectl delete *": "deny", "kubectl patch *": "deny", "kubectl edit *": "deny", "helm install *": "deny", "helm upgrade *": "deny", "helm uninstall *": "deny", "argocd sync *": "deny" },
        "task": { "*": "deny" }
      }
    },
    "general": {
      "description": "Architecture and design decision specialist operating on compressed evidence",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "prompt": "{file:./.opencode/prompts/sol-architect.md}",
      "temperature": 0.1,
      "steps": 30,
      "permission": {
        "read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "lsp": "allow", "edit": "deny", "external_directory": "deny", "question": "deny", "todowrite": "deny", "webfetch": "allow", "websearch": "allow",
        "bash": { "*": "allow", "rm *": "deny", "git commit *": "deny", "git push *": "deny", "git reset *": "deny", "git switch *": "deny", "git checkout *": "deny", "git clean *": "deny", "kubectl apply *": "deny", "kubectl delete *": "deny", "kubectl patch *": "deny", "kubectl edit *": "deny", "helm install *": "deny", "helm upgrade *": "deny", "helm uninstall *": "deny", "argocd sync *": "deny" },
        "task": { "*": "deny" }
      }
    },
    "luna-implement": {
      "description": "Implements one coarse-grained, bounded, already-decided repository change",
      "mode": "subagent", "hidden": true, "model": "openai/gpt-5.6-luna", "prompt": "{file:./.opencode/prompts/luna-implement.md}", "temperature": 0.1, "steps": 45,
      "permission": {
        "read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "lsp": "allow", "edit": "allow", "external_directory": "deny", "question": "deny", "todowrite": "deny", "webfetch": "allow", "websearch": "allow",
        "bash": { "*": "allow", "rm *": "deny", "git commit *": "deny", "git push *": "deny", "git reset *": "deny", "git switch *": "deny", "git checkout *": "deny", "git clean *": "deny", "kubectl apply *": "deny", "kubectl delete *": "deny", "kubectl patch *": "deny", "kubectl edit *": "deny", "helm install *": "deny", "helm upgrade *": "deny", "helm uninstall *": "deny", "argocd sync *": "deny" },
        "task": { "*": "deny" }
      }
    },
    "luna-verify": {
      "description": "Independently verifies a high-risk working-tree change against its contract",
      "mode": "subagent", "hidden": true, "model": "openai/gpt-5.6-luna", "prompt": "{file:./.opencode/prompts/luna-verify.md}", "temperature": 0.1, "steps": 30,
      "permission": {
        "read": "allow", "glob": "allow", "grep": "allow", "list": "allow", "lsp": "allow", "edit": "deny", "external_directory": "deny", "question": "deny", "todowrite": "deny", "webfetch": "allow", "websearch": "allow",
        "bash": { "*": "allow", "rm *": "deny", "git commit *": "deny", "git push *": "deny", "git reset *": "deny", "git switch *": "deny", "git checkout *": "deny", "git clean *": "deny", "kubectl apply *": "deny", "kubectl delete *": "deny", "kubectl patch *": "deny", "kubectl edit *": "deny", "helm install *": "deny", "helm upgrade *": "deny", "helm uninstall *": "deny", "argocd sync *": "deny" },
        "task": { "*": "deny" }
      }
    }
  }
}
