{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Create reviewable dependency-update PRs for Argo CD Application sources.",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "argocd",
    "kubernetes",
    "kustomize",
    "helm-values",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "Immich image tag is set under controllers.main.containers.main.image without a repository, so the helm-values manager cannot detect it. The server and machine-learning images share this tag.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^apps\\/immich\\/values\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\n\\s+tag: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\n"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/immich-app/immich-server"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^installs\\/[^/]+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps\\/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^apps\\/.*values[^/]*\\.ya?ml$/"
    ]
  },
  "automerge": false,
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "packageRules": [
    {
      "description": "Disable Helm values files outside apps/ because manager file patterns are additive to Renovate defaults.",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "!apps/**"
      ],
      "enabled": false
    },
    {
      "description": "Helm values own image references in values files, preventing duplicate image-update PRs from the Kubernetes manager.",
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "apps/**/*values*.yaml",
        "apps/**/*values*.yml"
      ],
      "enabled": false
    },
    {
      "description": "Ceph v20 and later and cephcsi v3.18 and later images require x86-64-v3 (AVX2), but the nodes expose x86-64-v2. Hold them until the node CPU model changes.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/ceph/ceph"
      ],
      "allowedVersions": "<20"
    },
    {
      "description": "Keep cephcsi images below v3.18 (x86-64-v3 required). Chart updates are unaffected because the image tag is pinned in values.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/cephcsi/cephcsi"
      ],
      "allowedVersions": "<3.18"
    },
    {
      "description": "Keep major-version upgrades distinct because they require a compatibility review and explicit rollback assessment.",
      "matchManagers": [
        "argocd",
        "kubernetes",
        "kustomize",
        "helm-values"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "Merge minor, patch, digest and pin updates automatically once the required ci-success check passes. Major updates stay manual.",
      "matchManagers": [
        "argocd",
        "kubernetes",
        "kustomize",
        "helm-values"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Keep cluster-critical and stateful components manual: CNI, storage, databases and their operators, certificates, secrets, identity, GitOps controllers and backups.",
      "matchFileNames": [
        "installs/cilium.yaml",
        "apps/cilium/**",
        "installs/rook-ceph-external.yaml",
        "apps/rook-ceph-external/**",
        "installs/ceph-csi.yaml",
        "apps/ceph-csi/**",
        "installs/external-snapshotter.yaml",
        "apps/external-snapshotter/**",
        "installs/cloudnative-pg-operator.yaml",
        "apps/cloudnative-pg-operator/**",
        "installs/plugin-barman-cloud.yaml",
        "apps/plugin-barman-cloud/**",
        "installs/mongodb-community-operator.yaml",
        "installs/*-postgres.yaml",
        "apps/*-postgres/**",
        "installs/volsync.yaml",
        "apps/volsync/**",
        "installs/cert-manager.yaml",
        "apps/cert-manager/**",
        "installs/sealed-secrets.yaml",
        "apps/sealed-secrets/**",
        "installs/authentik.yaml",
        "apps/authentik/**",
        "installs/argocd.yaml",
        "apps/argocd/**"
      ],
      "automerge": false
    }
  ],
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "merge-commit"
}
